---
/* mads.quote: a quotation with a coloured bar on its left. The text is the slot.
   <Quote accent="neon-pink">The best products come from…</Quote> */
import { madsColor } from './colors.js';

interface Props {
  accent?: string;
  class?: string;
  [attribute: string]: unknown;
}

const { accent, class: className, ...rest } = Astro.props;
---
<blockquote class:list={['mads-quote', className]} style={accent ? `--accent:${madsColor(accent)}` : undefined} {...rest}><slot /></blockquote>
